{
  "$schema": "https://raw.githubusercontent.com/Containerpak/cpak/v2/schema/manifest-v3.json",
  "manifest_version": "3.0",
  "name": "Vala and GTK SDK",
  "description": "Vala compiler with GTK, libadwaita and GObject development files.",
  "version": "0.56.18",
  "image": "ghcr.io/containerpak/sdk-vala@sha256:31c271f28e3dd5ad5baf7cb9b64f07547e90228dd6bdbdf1b9f1ae5212dcd5fe",
  "binaries": [
    "/usr/bin/valac",
    "/usr/bin/vapigen",
    "/usr/bin/pkg-config",
    "/usr/bin/meson",
    "/usr/bin/ninja"
  ],
  "desktop_entries": [],
  "dependencies": [],
  "addons": [],
  "addon_provider": {
    "id": "vala",
    "slot": "sdk.vala",
    "mode": "exclusive",
    "exports": {
      "path": [
        "/usr/bin"
      ]
    }
  },
  "idle_time": 0,
  "override": {
    "socketWayland": false,
    "socketPulseAudio": false,
    "socketSshAgent": true,
    "socketCups": false,
    "socketGpgAgent": true,
    "deviceDri": false,
    "deviceKvm": false,
    "deviceShm": false,
    "deviceAlsa": false,
    "deviceVideo": false,
    "deviceFuse": false,
    "deviceTun": false,
    "deviceUsb": false,
    "deviceAll": false,
    "notification": false,
    "openURI": false,
    "filesystem": [
      {
        "path": "home",
        "access": "read-write"
      }
    ],
    "env": [],
    "network": true,
    "process": false,
    "userNamespaces": false,
    "memoryMaxMB": 0,
    "cpuQuota": 0,
    "pidsMax": 0,
    "asRoot": false
  }
}
